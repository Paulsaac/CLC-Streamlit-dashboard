# Credenciales para el envío de correos de reportes
EMAIL_USER = "mercadolibre@leveraweb.com"
EMAIL_PASSWORD = "tu-contraseña-o-token-smtp"

# Opciones de servidor SMTP (Opcionales - Por defecto usa Gmail si no se especifican)
# SMTP_HOST = "smtp.leveraweb.com"   # o smtp.resend.com, mail.leveraweb.com, etc.
# SMTP_PORT = 587                    # 587 (TLS) o 465 (SSL)
# EMAIL_SENDER_NAME = "CLC Reportes - Mercado Libre"


[connections.gsheets]
type = "service_account"
project_id = "tu-project-id"
private_key_id = "tu-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\ntu-clave-privada\n-----END PRIVATE KEY-----\n"
client_email = "tu-service-account@tu-project.iam.gserviceaccount.com"
client_id = "tu-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/tu-service-account%40tu-project.iam.gserviceaccount.com"
universe_domain = "googleapis.com"

# URL del documento de Google Sheets
spreadsheet = "https://docs.google.com/spreadsheets/d/TU_ID_DE_SHEET/edit?usp=sharing"
